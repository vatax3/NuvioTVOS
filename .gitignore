# Generated by XcodeGen — project.yml is the source of truth
NuvioTVOS.xcodeproj/

.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Vendored mpv xcframeworks (~300 MB). Fetched by Scripts/fetch-mpv.sh rather than committed —
# GitHub rejects files over 100 MB and these are build inputs, not source.
Vendor/
build/
*.ipa
*.xcarchive

# SwiftPM's working directory for the local wrapper package: full clones of AetherEngine and its
# dependencies, fetched at pinned versions. Build inputs, like Vendor/ above, not source.
Packages/*/.build/

# The pin file is the exception, and it is source: `Package.swift` pins only to a minor, so this
# is what makes a release build reproducible rather than "whatever resolved that afternoon".
!Packages/*/Package.resolved
